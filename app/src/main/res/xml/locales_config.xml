<?xml version="1.0" encoding="utf-8"?>
<!--
  Languages MamaVoice ships with. Declaring them here exposes the app in the Android 13+
  system per-app language settings and bounds AppCompat's per-app locale switching.
  Nigerian Pidgin uses the ISO 639-3 / BCP-47 tag "pcm".
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pcm" />
    <locale android:name="yo" />
    <locale android:name="ig" />
    <locale android:name="ha" />
</locale-config>
